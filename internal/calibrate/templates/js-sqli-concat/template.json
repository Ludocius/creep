{
  "version": 1,
  "id": "js-sqli-concat",
  "class": "sqli",
  "language": "javascript",
  "pad_after": 3,
  "slots": {
    "route": ["search", "lookup", "list", "find", "browse", "filter"],
    "table": ["orders", "invoices", "tickets", "projects", "shipments", "payments"],
    "field": ["name", "user", "account", "author", "customer", "tenant"]
  },
  "vulnerable": {"sink_line": 7, "marker": "db.query(sql, (err"},
  "safe": {"sink_line": 7, "marker": "db.query(sql, ["}
}
