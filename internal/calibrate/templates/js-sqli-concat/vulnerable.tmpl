const express = require("express");
const db = require("./db");
const router = express.Router();

router.get("/@@route@@", (req, res) => {
  const sql = "SELECT * FROM @@table@@ WHERE owner = '" + req.query.@@field@@ + "'";
  db.query(sql, (err, rows) => res.json(rows));
});

module.exports = router;
