{
  "version": 1,
  "id": "js-missing-auth-delete",
  "class": "missing_auth",
  "language": "javascript",
  "pad_after": 4,
  "slots": {
    "route": ["users", "projects", "teams", "webhooks", "tokens", "groups"],
